source leaprc.protein.ff19SB
source leaprc.water.opc
loadamberparams frcmod.ionslm_126_opc
addAtomTypes { { "J1" "Fe" "sp3" } { "J2" "Fe" "sp3" } { "J3" "S" "sp3" } { "J4" "S" "sp3" } { "J5" "S" "sp3" } { "J6" "S" "sp3" } { "J7" "S" "sp3" } { "J8" "S" "sp3" } }
loadamberparams FeS_twoplus.frcmod
FSC = loadmol2 FSC_core.mol2
loadoff C1C.lib
loadoff C2C.lib
loadoff C3C.lib
loadoff C4C.lib
mol = loadpdb clean.pdb
bond mol.38.SG mol.193.FE1
bond mol.43.SG mol.193.FE1
bond mol.46.SG mol.193.FE2
bond mol.76.SG mol.193.FE2
bond mol.136.SG mol.194.FE1
bond mol.141.SG mol.194.FE1
bond mol.144.SG mol.194.FE2
bond mol.174.SG mol.194.FE2
saveamberparm mol dry.prmtop dry.inpcrd
solvatebox mol OPCBOX 10.0
addIonsRand mol Na+ 0
addIonsRand mol Cl- 0
saveamberparm mol system.prmtop system.inpcrd
savepdb mol system_leap.pdb
quit
