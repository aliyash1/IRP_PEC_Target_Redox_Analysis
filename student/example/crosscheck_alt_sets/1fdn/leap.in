source leaprc.protein.ff19SB
source leaprc.water.opc
loadamberparams frcmod.ionslm_126_opc
addAtomTypes { { "71" "Fe" "sp3" } { "72" "Fe" "sp3" } { "73" "Fe" "sp3" } { "74" "Fe" "sp3" } { "75" "S" "sp3" } { "76" "S" "sp3" } { "77" "S" "sp3" } { "78" "S" "sp3" } { "79" "S" "sp3" } { "7a" "S" "sp3" } { "7b" "S" "sp3" } { "7c" "S" "sp3" } }
loadamberparams FeS_twoplus.frcmod
FSH = loadmol2 FSH_core.mol2
loadoff C1H.lib
loadoff C2H.lib
loadoff C3H.lib
loadoff C4H.lib
mol = loadpdb clean.pdb
bond mol.47.SG mol.56.FE1
bond mol.14.SG mol.56.FE2
bond mol.8.SG mol.56.FE3
bond mol.11.SG mol.56.FE4
bond mol.18.SG mol.57.FE1
bond mol.43.SG mol.57.FE2
bond mol.37.SG mol.57.FE3
bond mol.40.SG mol.57.FE4
saveamberparm mol dry.prmtop dry.inpcrd
solvatebox mol OPCBOX 10.0
addIonsRand mol Na+ 0
addIonsRand mol Cl- 0
saveamberparm mol system.prmtop system.inpcrd
savepdb mol system_leap.pdb
quit
